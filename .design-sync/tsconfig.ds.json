/*
  tsconfig for the Claude Design build only — never for the app or the tests.

  Two traps, both silent:

  - Write comments as a block like this one, NOT as a `"//"` key. The converter strips
    comments with a regex that treats `"//":` as a line comment, mangling the JSON; it
    then parses nothing and drops the paths mapping without saying so.
  - The target must end in a bare `*`, never `*.js`. The plugin strips only a trailing
    `*` and appends its own extension list, so `*.js` becomes a literal directory name,
    the rule never matches, and the broader `/*` rule below silently wins — sending icon
    imports back to the real .svg files.

  `@plone/registry` points at the overlay's globalThis-memoised singleton so the converter
  bundle and standalone story previews share one populated Config instance.
  `@root/reducers` lets `@plone/volto/storybook`'s RealStoreWrapper bundle cleanly.
*/
{
  "extends": "../frontend/packages/volto-light-theme/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@plone/registry": ["./nm-overlay/@plone/registry/index.js"],
      "@root/reducers": ["./nm-overlay/@root/reducers.js"],
      "@root/*": ["../frontend/core/packages/volto/src/*"],
      "@plone/volto/icons/*": ["./.cache/volto-icons/*"],
      "@plone/volto/*": ["./nm-overlay/@plone/volto/*"],
      "@plone/volto-slate": ["./nm-overlay/@plone/volto-slate/index.js"],
      "@plone/volto-slate/*": ["./nm-overlay/@plone/volto-slate/*"],
      "@eeacms/volto-accordion-block": [
        "./nm-overlay/@eeacms/volto-accordion-block/index.js"
      ],
      "@eeacms/volto-accordion-block/*": [
        "./nm-overlay/@eeacms/volto-accordion-block/*"
      ],
      "@kitconcept/volto-banner-block": [
        "./nm-overlay/@kitconcept/volto-banner-block/index.js"
      ],
      "@kitconcept/volto-banner-block/*": [
        "./nm-overlay/@kitconcept/volto-banner-block/*"
      ],
      "@kitconcept/volto-bm3-compat": [
        "./nm-overlay/@kitconcept/volto-bm3-compat/index.ts"
      ],
      "@kitconcept/volto-bm3-compat/*": [
        "./nm-overlay/@kitconcept/volto-bm3-compat/*"
      ],
      "@kitconcept/volto-button-block": [
        "./nm-overlay/@kitconcept/volto-button-block/index.ts"
      ],
      "@kitconcept/volto-button-block/*": [
        "./nm-overlay/@kitconcept/volto-button-block/*"
      ],
      "@kitconcept/volto-calendar-block": [
        "./nm-overlay/@kitconcept/volto-calendar-block/index.ts"
      ],
      "@kitconcept/volto-calendar-block/*": [
        "./nm-overlay/@kitconcept/volto-calendar-block/*"
      ],
      "@kitconcept/volto-carousel-block": [
        "./nm-overlay/@kitconcept/volto-carousel-block/index.ts"
      ],
      "@kitconcept/volto-carousel-block/*": [
        "./nm-overlay/@kitconcept/volto-carousel-block/*"
      ],
      "@kitconcept/volto-heading-block": [
        "./nm-overlay/@kitconcept/volto-heading-block/index.js"
      ],
      "@kitconcept/volto-heading-block/*": [
        "./nm-overlay/@kitconcept/volto-heading-block/*"
      ],
      "@kitconcept/volto-highlight-block": [
        "./nm-overlay/@kitconcept/volto-highlight-block/index.ts"
      ],
      "@kitconcept/volto-highlight-block/*": [
        "./nm-overlay/@kitconcept/volto-highlight-block/*"
      ],
      "@kitconcept/volto-introduction-block": [
        "./nm-overlay/@kitconcept/volto-introduction-block/index.js"
      ],
      "@kitconcept/volto-introduction-block/*": [
        "./nm-overlay/@kitconcept/volto-introduction-block/*"
      ],
      "@kitconcept/volto-light-theme/icons/*": ["./.cache/vlt-icons/*"],
      "@kitconcept/volto-light-theme": [
        "./nm-overlay/@kitconcept/volto-light-theme/index.ts"
      ],
      "@kitconcept/volto-light-theme/*": [
        "./nm-overlay/@kitconcept/volto-light-theme/*"
      ],
      "@kitconcept/volto-logos-block": [
        "./nm-overlay/@kitconcept/volto-logos-block/index.ts"
      ],
      "@kitconcept/volto-logos-block/*": [
        "./nm-overlay/@kitconcept/volto-logos-block/*"
      ],
      "@kitconcept/volto-separator-block": [
        "./nm-overlay/@kitconcept/volto-separator-block/index.ts"
      ],
      "@kitconcept/volto-separator-block/*": [
        "./nm-overlay/@kitconcept/volto-separator-block/*"
      ],
      "@kitconcept/volto-slider-block": [
        "./nm-overlay/@kitconcept/volto-slider-block/index.ts"
      ],
      "@kitconcept/volto-slider-block/*": [
        "./nm-overlay/@kitconcept/volto-slider-block/*"
      ],
      "@kitconcept/volto-social-blocks": [
        "./nm-overlay/@kitconcept/volto-social-blocks/index.ts"
      ],
      "@kitconcept/volto-social-blocks/*": [
        "./nm-overlay/@kitconcept/volto-social-blocks/*"
      ],
      "@plonegovbr/volto-social-media/icons/*": ["./.cache/sm-icons/*"],
      "@plonegovbr/volto-social-media": [
        "./nm-overlay/@plonegovbr/volto-social-media/index.ts"
      ],
      "@plonegovbr/volto-social-media/*": [
        "./nm-overlay/@plonegovbr/volto-social-media/*"
      ],
      "@plone-collective/volto-image-editor": [
        "./nm-overlay/@plone-collective/volto-image-editor/index.ts"
      ],
      "@plone-collective/volto-image-editor/*": [
        "./nm-overlay/@plone-collective/volto-image-editor/*"
      ],
      "@simplesconsultoria/volto-light-theme/icons/*": ["./.cache/sc-icons/*"],
      "@simplesconsultoria/volto-light-theme/*": [
        "../frontend/packages/volto-light-theme/src/*"
      ]
    }
  }
}
