  "compilerOptions": {
    "paths": {
      "@plone/volto/*": ["../../core/packages/volto/src/*"],
      "@plone/volto-slate/*": ["../../core/packages/volto/node_modules/@plone/volto-slate/src/*"],
      "@storybook/react": ["../../core/packages/volto/node_modules/@storybook/react"],
      "github-slugger": ["../../core/packages/volto/node_modules/github-slugger"],
      "react-popper": ["../../core/packages/volto/node_modules/react-popper"],
