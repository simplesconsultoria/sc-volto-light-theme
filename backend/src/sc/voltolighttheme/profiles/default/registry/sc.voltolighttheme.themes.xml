<?xml version="1.0" encoding="utf-8"?>
<registry xmlns:i18n="http://xml.zope.org/namespaces/i18n"
          i18n:domain="sc.voltolighttheme"
>

  <!--
    Theme definitions. One <records> block per theme; the theme id is the last
    segment of the prefix, so it must not contain a dot.
    The "default" theme is shipped with the add-on and cannot be deleted.
  -->

  <records interface="sc.voltolighttheme.interfaces.ISCVLTThemeDefinition"
           prefix="sc.voltolighttheme.theme.default"
  >
    <value key="name"
           i18n:translate=""
    >Default</value>
    <value key="description"
           i18n:translate=""
    >The theme shipped with sc.voltolighttheme.</value>
    <value key="color_groups">{"primary": {"id": "primary", "name": "Primary", "font_family": "Inter, sans-serif", "background_color_light": "#ffffff", "background_color_dark": "#000000", "text_color_light": "#000000", "text_color_dark": "#ffffff", "subtext_color_light": "#333333", "subtext_color_dark": "#f8f8f8", "accent_color_light": "#b55e1c", "accent_color_dark": "#f4822c"}, "secondary": {"id": "secondary", "name": "Secondary", "font_family": "Inter, sans-serif", "background_color_light": "#000000", "background_color_dark": "#ffffff", "text_color_light": "#ffffff", "text_color_dark": "#000000", "subtext_color_light": "#e6e6e6", "subtext_color_dark": "#333333", "accent_color_light": "#f4822c", "accent_color_dark": "#f4822c"}, "accent": {"id": "accent", "name": "Accent", "font_family": "Inter, sans-serif", "background_color_light": "#f4822c", "background_color_dark": "#b55e1c", "text_color_light": "#000000", "text_color_dark": "#ffffff", "subtext_color_light": "#333333", "subtext_color_dark": "#f8f8f8", "accent_color_light": "#000000", "accent_color_dark": "#ffffff"}, "neutral": {"id": "neutral", "name": "Neutral", "font_family": "Inter, sans-serif", "background_color_light": "#edeff0", "background_color_dark": "#333333", "text_color_light": "#000000", "text_color_dark": "#ffffff", "subtext_color_light": "#333333", "subtext_color_dark": "#e6e6e6", "accent_color_light": "#f4822c", "accent_color_dark": "#f4822c"}}</value>
    <value key="block_themes">{"default": {"id": "default", "name": "Primary", "back_color_group": "primary", "front_color_group": "neutral"}, "alternative": {"id": "alternative", "name": "Alternative", "back_color_group": "accent", "front_color_group": "primary"}}</value>
  </records>

</registry>
