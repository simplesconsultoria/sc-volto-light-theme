<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="sc.voltolighttheme"
    >

  <!--
    Named adapter: plone.restapi looks control panels up by name via
    getAdapters((context, request), IControlpanel). The IControlpanelLayer
    marker is applied to the request by the services themselves.
  -->
  <adapter
      factory=".themes.ThemesControlpanel"
      name="themes"
      provides="sc.voltolighttheme.interfaces.ISCVLTThemesControlpanel"
      for="zope.interface.Interface
           plone.restapi.interfaces.IControlpanelLayer"
      />

</configure>
