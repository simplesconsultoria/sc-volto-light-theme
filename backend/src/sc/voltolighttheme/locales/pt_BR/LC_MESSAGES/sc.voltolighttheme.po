msgstr "Caso seu site tenha um cabeçalho de intranet, ele será exibido no lado direito do cabeçalho."

#. Default: "If enabled, the fat menu will be shown."
#: sc/voltolighttheme/behaviors/header.py:39
msgid "help_enable_fat_menu"
msgstr "Caso ativado, o menu expandido será exibido."

#. Default: "The text that shows in the right side of the footer colophon."
#: sc/voltolighttheme/behaviors/footer.py:192
msgid "help_footer_colophon_right_text"
msgstr "O texto que é exibido no lado direito do colofão do rodapé."

