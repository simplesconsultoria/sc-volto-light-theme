#. Default: "If your site has an intranet header, it will show in the right side of the header."
#: sc/voltolighttheme/behaviors/header.py:107
msgid "help_complementary_logo"
msgstr "Caso seu site tenha um cabeçalho de intranet, ele será exibido no lado direito do cabeçalho."

#. Default: "If enabled, the fat menu will be shown."
#: sc/voltolighttheme/behaviors/header.py:39
msgid "help_enable_fat_menu"
msgstr "Caso ativado, o menu expandido será exibido."

#. Default: "The text that shows in the right side of the footer colophon."
#: sc/voltolighttheme/behaviors/footer.py:192
msgid "help_footer_colophon_right_text"
msgstr "O texto que é exibido no lado direito do colofão do rodapé."

#. Default: "The text that shows in the footer colophon."
#: sc/voltolighttheme/behaviors/footer.py:150
msgid "help_footer_colophon_text"
msgstr "O texto que é exibido no colofão do rodapé."

#. Default: "The footer has a main logo located in the lower left side, above the address. In case that the footer has a dark  background, you can set this inversed logo to ensure it plays well with the background color. If not set, the main site logo will be used."
#: sc/voltolighttheme/behaviors/footer.py:222
msgid "help_footer_logo"
msgstr "O rodapé tem um logo principal no lado inferior esquerdo, acima do endereço. Caso o rodapé tenha um fundo escuro, você pode definir este logo invertido para garantir que ele combine com a cor de fundo. Se não for definido, será usado o logo principal do site."

#. Default: "If enabled, the intranet header will be shown."
#: sc/voltolighttheme/behaviors/header.py:117
msgid "help_has_intranet_header"
msgstr "Caso ativado, o cabeçalho de intranet será exibido."

#. Default: "The site actions are the links that show in the top right side of the header."
#: sc/voltolighttheme/behaviors/header.py:56
msgid "help_header_actions"
msgstr "As ações do site são os links que aparecem no canto superior direito do cabeçalho."

#. Default: "The colored pill at the top left of the header."
#: sc/voltolighttheme/behaviors/header.py:127
msgid "help_intranet_flag"
msgstr "A etiqueta colorida no canto superior esquerdo do cabeçalho."

#. Default: "If the site or subsite has a logo, please upload it here."
#: sc/voltolighttheme/behaviors/header.py:30
msgid "help_site_logo"
msgstr "Caso o site ou subsite tenha um logo, faça o upload aqui."

#. Default: "The theme applied to this site or section."
#: sc/voltolighttheme/behaviors/theme.py:33
msgid "help_theme"
msgstr "O tema aplicado a este site ou seção."

